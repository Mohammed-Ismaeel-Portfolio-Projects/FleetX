APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime transport: Laravel Reverb (Pusher protocol).
# Local: php artisan reverb:start
# Unset BROADCAST_CONNECTION falls back to reverb (config/broadcasting.php).
# PHPUnit forces BROADCAST_CONNECTION=log so tests never require a WS server.
# Keep BROADCAST_CONNECTION=log in .env only when no WS server is running.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=your_reverb_app_id
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dashboard Echo (copy into dashboard-web/.env — do not commit real secrets)
# VITE_REALTIME_ENABLED=true
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# VITE_PUSHER_APP_CLUSTER=mt1

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=10080
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_SHOW_BLACKLIST_EXCEPTION=true
JWT_BLACKLIST_GRACE_PERIOD=0

# Routing
ROUTING_PROVIDER=graphhopper
ROUTING_FALLBACK_ENABLED=true
ROUTING_FALLBACK_PROVIDER=simulator

GRAPH_HOPPER_API_KEY=
GRAPH_HOPPER_URL=https://graphhopper.com/api/1
GRAPH_HOPPER_PROFILE=truck
GRAPH_HOPPER_VEHICLE_TYPE=heavy_truck
GRAPH_HOPPER_TRUCK_RESTRICTIONS=true
GRAPH_HOPPER_ENABLE_FLEXIBLE_ROUTING=false
GRAPH_HOPPER_TIMEOUT=30

ROUTE_DEVIATION_ENABLED=true
ROUTE_DEVIATION_THRESHOLD_METERS=100
AUTO_REROUTE_ENABLED=true
ROUTE_CACHE_TTL_SECONDS=21600
ROUTE_REROUTE_COOLDOWN_SECONDS=120

# Driver push (D12) — Expo Push Service. Inbox remains source of truth.
# Leave enabled in production once EAS + FCM/APNs credentials are configured.
DRIVER_PUSH_ENABLED=true
DRIVER_PUSH_PROVIDER=expo
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_TIMEOUT=8
# Optional Expo access token (rate limits). Never put this in the mobile app.
EXPO_ACCESS_TOKEN=

# Driver speed safety (D14) — configured threshold, not legal road limits.
DRIVER_SAFETY_SPEED_ENABLED=true
DRIVER_SAFETY_SPEED_THRESHOLD_KMH=110
DRIVER_SAFETY_SPEED_MIN_SAMPLES=3
DRIVER_SAFETY_SPEED_MIN_DURATION_SECONDS=10
DRIVER_SAFETY_SPEED_COOLDOWN_SECONDS=300
DRIVER_SAFETY_SPEED_RECOVERY_KMH=95
DRIVER_SAFETY_SPEED_MAX_ACCURACY_METERS=50
DRIVER_SAFETY_SPEED_MAX_SAMPLE_AGE_SECONDS=30
DRIVER_SAFETY_SPEED_MAX_PLAUSIBLE_KMH=200
DRIVER_SAFETY_SPEED_LOOKBACK_SECONDS=120

# Driver live motion safety (D15-B) — operational m/s² policy, not sim 60s ramps, not legal limits.
DRIVER_SAFETY_MOTION_ENABLED=true
DRIVER_SAFETY_MOTION_MIN_SAMPLES=3
DRIVER_SAFETY_MOTION_MIN_DURATION_SECONDS=10
DRIVER_SAFETY_MOTION_COOLDOWN_SECONDS=300
DRIVER_SAFETY_MOTION_MIN_INTERVAL_SECONDS=3
DRIVER_SAFETY_MOTION_MAX_INTERVAL_SECONDS=15
DRIVER_SAFETY_MOTION_MAX_PLAUSIBLE_DECEL_MS2=8.0
DRIVER_SAFETY_MOTION_MAX_ACCURACY_METERS=50
DRIVER_SAFETY_MOTION_MAX_SAMPLE_AGE_SECONDS=30
DRIVER_SAFETY_MOTION_LOOKBACK_SECONDS=120
DRIVER_SAFETY_MOTION_RECOVERY_DECEL_MS2=0.5
DRIVER_SAFETY_MOTION_HARSH_BRAKE_VAN_MS2=2.5
DRIVER_SAFETY_MOTION_HARSH_BRAKE_LIGHT_MS2=2.0
DRIVER_SAFETY_MOTION_HARSH_BRAKE_HEAVY_MS2=1.5
DRIVER_SAFETY_MOTION_STOP_MOVING_MIN_KMH=30
DRIVER_SAFETY_MOTION_STOP_STOPPED_MAX_KMH=5
DRIVER_SAFETY_MOTION_STOP_MIN_DROP_KMH=25

OSRM_URL=http://localhost:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT=30

# Stripe Billing (Monthly Invoices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
