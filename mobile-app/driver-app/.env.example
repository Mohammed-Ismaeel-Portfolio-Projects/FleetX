# FleetX Driver App — environment template (D1)
#
# Copy to .env and adjust for your runtime. Never commit .env with secrets.
#
# === Environment ===
# Omit EXPO_PUBLIC_ENV (or set development) for local HTTP.
# Production: EXPO_PUBLIC_ENV=production requires https:// API URL (no localhost).
# Production also hard-disables cleartext HTTP/ATS bypass and realtime (see config.ts).
#
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com/api/v1
# EXPO_PUBLIC_REALTIME_ENABLED=false
# EXPO_PUBLIC_ALLOW_INSECURE_HTTP is ignored when EXPO_PUBLIC_ENV=production
#
# Local cleartext is allowed when not production (see app.config.js).
# Override: EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true|false
#
# === Host reachability (API + Reverb must use the SAME host alias) ===
#
# Expo Web on this machine:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=localhost
#
# Android emulator:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=10.0.2.2
#
# Physical device on same LAN (replace with your PC LAN IP):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=192.168.x.x
#
# === Dev-only login prefill (NEVER for production) ===
# Requires __DEV__ builds AND EXPO_PUBLIC_DRIVER_DEV_PREFILL=true
# EXPO_PUBLIC_DRIVER_DEV_PREFILL=true
# EXPO_PUBLIC_DRIVER_DEV_EMAIL=
# EXPO_PUBLIC_DRIVER_DEV_PASSWORD=

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_REALTIME_ENABLED=false
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# Device push (D12) — Expo project ID required for getExpoPushTokenAsync on device builds.
# Create an EAS project and set the UUID here. Without it, in-app Alerts still work.
# EXPO_PUBLIC_EAS_PROJECT_ID=
