# FleetX Customer App — environment template (C5.10 release-ready)
#
# Copy to .env and adjust for your runtime. Never commit .env with secrets.
#
# === Host reachability (API + Reverb must use the SAME host alias) ===
#
# Expo Web on this machine:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=localhost
#
# Android emulator (host machine from emulator):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=10.0.2.2
#
# Physical device on same LAN (replace with your PC LAN IP):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api/v1
#   EXPO_PUBLIC_REVERB_HOST=192.168.x.x
#
# iOS simulator (Mac): localhost usually works for API + Reverb.
#
# Do NOT hardcode LAN IPs in application source — set them here only.
#
# === Maps / location picker ===
#
# Interactive pickup/delivery selection uses react-native-maps on iOS/Android
# and OpenStreetMap tiles on web. Routing/geocoding credentials stay on the
# backend. NEVER put GRAPH_HOPPER_API_KEY (or any server secret) here.
#
# === Android Google Maps (SHIPMENT-REQUEST-07D) ===
#
# Google Cloud (developer must create — do not invent keys in git):
#   1. Enable "Maps SDK for Android" on your Google Cloud project (billing as required).
#   2. Create an API key restricted to Android apps.
#   3. Package name: com.fleetx.client
#   4. Add the SHA-1 of the development/debug keystore used by `npm run android:dev`
#      (and release SHA-1 for store builds).
#
# Expo Go:
#   Cannot embed this project's Android Maps API key. Expect blank/unavailable maps.
#   EXPO GO LIMITATION CONFIRMED for project-specific Google Maps credentials.
#
# Development build (required for Android map imagery):
#   1. Set EXPO_PUBLIC_GOOGLE_MAPS_API_KEY in local .env (never commit the real value).
#   2. npm run android:dev
#      (equivalent: npx expo run:android)
#   3. Optional first-time native project generation: npm run android:prebuild
#   4. After changing the key, REBUILD the native binary — Metro reload is not enough.
#
# Verify isolation: open /map-android-diagnostic in the development build.
# Web uses Leaflet/OSM — no Google key. Web PASS ≠ Android PASS.
# Search / current location still work without map imagery.
#
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
#
# === Transport / cleartext (C5.10) ===
#
# Local HTTP is allowed only when insecure transport is opted in.
# app.config.js enables Android cleartext + iOS ATS exception when:
#   EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true
#   OR EXPO_PUBLIC_ENV is not "production" (default local/dev)
#
# Production builds MUST set:
#   EXPO_PUBLIC_ENV=production
#   EXPO_PUBLIC_API_BASE_URL=https://<api-host>/api/v1
#   EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false   # optional; production defaults secure
#   EXPO_PUBLIC_REVERB_SCHEME=https         # if realtime enabled

# --- Local / development defaults ---
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_REALTIME_ENABLED=false
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# --- Production example (do not use localhost) ---
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# EXPO_PUBLIC_REALTIME_ENABLED=false
# EXPO_PUBLIC_REVERB_APP_KEY=
# EXPO_PUBLIC_REVERB_HOST=realtime.example.com
# EXPO_PUBLIC_REVERB_PORT=443
# EXPO_PUBLIC_REVERB_SCHEME=https

# Android emulator example (copy into .env when testing on emulator):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# EXPO_PUBLIC_REVERB_HOST=10.0.2.2
# EXPO_PUBLIC_REALTIME_ENABLED=true
# EXPO_PUBLIC_REVERB_APP_KEY=<from backend .env REVERB_APP_KEY>
