# FleetX dashboard — realtime (Laravel Reverb / Pusher protocol)
# Copy to .env and align keys with backend REVERB_* values.
# Enable only when `php artisan reverb:start` is running.

VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_REALTIME_ENABLED=true

VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Alias used by some Echo setups / legacy tracking docs
VITE_PUSHER_APP_KEY=your_reverb_app_key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=8080
VITE_PUSHER_SCHEME=http
VITE_PUSHER_APP_CLUSTER=mt1
